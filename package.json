{
  "name": "tsewa",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run @tsewa/web#build",
    "dev": "vp run @tsewa/web#dev",
    "build": "vp run @tsewa/web#build",
    "deploy": "vp run @tsewa/web#deploy",
    "deploy:hosted": "vp run @tsewa/web#deploy:hosted",
    "deploy:self-hosted": "vp run @tsewa/web#deploy:self-hosted",
    "marketing:dev": "vp run @tsewa/marketing#dev",
    "marketing:build": "vp run @tsewa/marketing#build",
    "marketing:deploy": "vp run @tsewa/marketing#deploy",
    "marketing:typecheck": "vp run @tsewa/marketing#typecheck",
