    "cf-typegen": "vp run @tsewa/web#cf-typegen",
    "db:migrate:local": "vp run @tsewa/web#db:migrate:local",
    "db:migrate:remote": "vp run @tsewa/web#db:migrate:remote",
    "db:migrate:hosted": "vp run @tsewa/web#db:migrate:hosted",
    "db:migrate:self-hosted": "vp run @tsewa/web#db:migrate:self-hosted",
    "self-host:check": "vp run @tsewa/web#self-host:check",
