# Create a PostHog EU project, then provide these only to the production build.
# The public project key is safe to embed; never put a PostHog personal API key here.
VITE_POSTHOG_KEY=phc_replace_with_public_project_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_UI_HOST=https://eu.posthog.com
