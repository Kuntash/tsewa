{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tsewa-r2-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["RELAY_TOKEN"],
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
  },
  "r2_buckets": [
    {
      "binding": "SOURCE_FILES",
      "bucket_name": "tibetan-homes",
    },
    {
      "binding": "TARGET_FILES",
      "bucket_name": "tsewa-self-hosted-files",
    },
  ],
}
